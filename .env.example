# AI 配置
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_API_KEY=your_key_here
AI_MODEL=glm-4

# 助手上下文（也可在“小助手配置”中覆盖）
# CONTEXT_COMPRESSION_MODEL_ID=1
# CONTEXT_COMPRESSION_TEMPERATURE=0.1
# CONTEXT_SUMMARY_MAX_TOKENS=800
# CONTEXT_MAX_TOKENS=12000
# CONTEXT_SOFT_LIMIT_TOKENS=8400
# CONTEXT_HARD_LIMIT_TOKENS=10200
# CONTEXT_KEEP_RECENT_MESSAGES=8

# 通知配置 - Telegram
NOTIFY_TELEGRAM_BOT_TOKEN=your_bot_token
NOTIFY_TELEGRAM_CHAT_ID=your_chat_id

# 代理配置（国内访问 Telegram 可能需要）
# HTTP_PROXY=http://127.0.0.1:7890

# SSL 企业证书（Zscaler 等企业代理环境需要，留空则不启用）
# CA_CERT_FILE=/path/to/your/enterprise-cert.crt

# 调度配置（cron 表达式：分 时 日 月 周）
DAILY_REPORT_CRON=30 15 * * 1-5

# ---------------------------------------------------------------------------
# India fork: compliance (docs/adr.md ADR-002, ADR-004)
# ---------------------------------------------------------------------------

# Advisory mode. Read from the environment only; there is no UI setting.
#   research_only  (default) research and education only: no buy/sell/hold calls,
#                  targets, entries, stop-losses or position sizes. Enforced by the
#                  output guard and by switching recommendation features off.
#   ra_registered  for a SEBI-registered research analyst. Requires RA_REGISTRATION_NUMBER
#                  and RA_NAME, or startup fails. In this release it still behaves like
#                  research_only: recommendations only become publishable once the
#                  analyst review queue ships.
ADVISORY_MODE=research_only

# Research analyst details (required when ADVISORY_MODE=ra_registered).
# RA_REGISTRATION_NUMBER: "INH" followed by 9 digits, e.g. INH000012345.
# RA_REGISTRATION_NUMBER=
# RA_NAME=
# Optional: shown with the registration details.
# RA_CONTACT=
# RA_DISCLOSURE_URL=

# MCP server for external AI clients (/mcp, /api/pats personal access tokens, and
# /.well-known discovery). Off by default; set to true to mount it.
# MCP_ENABLED=false

# ---------------------------------------------------------------------------
# India market data (Phase 2)
# ---------------------------------------------------------------------------

# Encrypts users' broker API keys and access tokens at rest (AES-256-GCM).
# Broker connections stay disabled until this is set. Generate a key with:
#   python -m src.platform.security.credential_vault
# Format: <key-id>:<base64>, comma-separated. The first key encrypts and every listed
# key decrypts, so to rotate: put a new key first, let stored values be re-encrypted,
# then remove the old key. Losing every key means users must re-enter their broker keys.
# CREDENTIALS_MASTER_KEY=

# Deployment environment. Anything other than development/dev/local/test counts as
# production, and a missing value counts as production too.
# APP_ENV=development

# Development only: enable the unofficial, delayed Yahoo Finance source for NSE/BSE.
# Ignored unless APP_ENV is development/dev/local/test. Never enable in production:
# Yahoo's terms do not allow redistributing its data.
# ALLOW_UNOFFICIAL_DATA=false
